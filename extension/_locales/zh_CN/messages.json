{
  "manifestName": {
    "message": "Tabulor",
    "description": "扩展名称，显示在 chrome://extensions 与工具栏提示中。"
  },
  "manifestDescription": {
    "message": "管理你的标签页——本地化的新标签页仪表盘，提供终端风格的视图，可分组、重命名、合并打开的标签。",
    "description": "扩展描述，显示在 chrome://extensions 中。"
  },
  "openTabs": { "message": "打开的标签" },
  "readingList": { "message": "阅读列表" },
  "unread": { "message": "未读" },
  "done": { "message": "已完成" },
  "emptyTitle": { "message": "标签页收件箱已清零。" },
  "emptySubtitle": { "message": "可以喘口气了。" },
  "readingListEmpty": { "message": "还没有保存。先活在当下。" },
