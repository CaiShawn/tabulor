  "timeMinAgo_other": { "message": "$N$ 分钟前", "placeholders": { "n": { "content": "$1" } } },
  "timeHrAgo_one": { "message": "$N$ 小时前", "placeholders": { "n": { "content": "$1" } } },
  "timeHrAgo_other": { "message": "$N$ 小时前", "placeholders": { "n": { "content": "$1" } } },
  "timeYesterday": { "message": "昨天" },
  "timeDaysAgo_one": { "message": "$N$ 天前", "placeholders": { "n": { "content": "$1" } } },
  "timeDaysAgo_other": { "message": "$N$ 天前", "placeholders": { "n": { "content": "$1" } } }
